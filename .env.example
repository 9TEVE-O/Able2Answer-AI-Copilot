# Abel configuration — copy to .env and fill in, or export these in your shell.
# Abel reads these with os.getenv; it does not auto-load .env files.

# --- Core -------------------------------------------------------------------
# Required for online mode (ABEL_MODE=online, the default).
ANTHROPIC_API_KEY=

# online  = answer via the Claude API
# offline = answer entirely locally via Ollama + the bundled knowledge base
ABEL_MODE=online

# Where the SQLite knowledge base and taste profile are stored.
ABEL_DATA_DIR=~/.abel

# --- Offline mode -----------------------------------------------------------
# Ollama model used when ABEL_MODE=offline. Requires: pip install -e ".[offline]"
ABEL_LOCAL_MODEL=llama3.1

# --- Music taste profile (all optional) -------------------------------------
# Requires: pip install -e ".[music-profile]"
# Create an app at https://developer.spotify.com to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# iTunes / Apple Music library XML. Auto-detected on macOS; set to override.
ITUNES_LIBRARY_PATH=

# Colon-separated directories to scan for local audio file tags.
ABEL_MUSIC_DIRS=
